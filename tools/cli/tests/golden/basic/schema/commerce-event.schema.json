{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "x-omnirec-standard-events": [
        "product_shared",
        "product_viewed",
        "account_linked"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Product identifier."
            },
            "price": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "description": "A product as shown to the shopper."
        }
      },
      "additionalProperties": true
    }
  }
}
