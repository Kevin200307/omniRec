<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.omnirec</groupId>
  <artifactId>omnirec-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <awssdk.version>2.28.16</awssdk.version>
    <algoliasearch.version>4.1.0</algoliasearch.version>
    <google-cloud-retail.version>2.58.0</google-cloud-retail.version>
  </properties>

  <modules>
    <module>omnirec-core</module>
    <module>omnirec-web</module>
    <module>omnirec-personalize-starter</module>
    <module>omnirec-algolia-starter</module>
    <module>omnirec-google-recai-starter</module>
    <module>omnirec-redis-starter</module>
    <module>omnirec-contract-tests</module>
    <module>omnirec-demo-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Every starter depends on the core interfaces + canonical DTOs. -->
      <dependency>
        <groupId>io.omnirec</groupId>
        <artifactId>omnirec-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.omnirec</groupId>
        <artifactId>omnirec-web</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.algolia</groupId>
        <artifactId>algoliasearch</artifactId>
        <version>${algoliasearch.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>google-cloud-retail</artifactId>
        <version>${google-cloud-retail.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Required for Spring MVC to resolve @RequestParam/@PathVariable names via reflection without explicit value= on every annotation. spring-boot-starter-parent sets this by default; we don't extend it, so it's set here instead. -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
