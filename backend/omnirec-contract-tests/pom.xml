<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-contract-tests</artifactId>
  <packaging>jar</packaging>
  <description>
    Cross-language contract enforcement. Two jobs: (1) the canonical CommerceEvent taxonomy is
    defined in TypeScript, Java, and JSON Schema, and this module fails the build if the three
    drift apart; (2) one fixture event is run through every provider mapper to assert no required
    field is silently dropped. No live provider credentials are used - only pure mapper methods.
  </description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-commerce-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-event-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-personalize-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-google-recai-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
