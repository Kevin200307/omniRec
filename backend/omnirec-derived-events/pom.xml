<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>omnirec-derived-events</artifactId>
  <packaging>jar</packaging>
  <description>
    Events nobody clicks: cart_abandoned, checkout_abandoned, return_visit, new_customer_purchase and
    repeat_purchase, computed from the event stream by rules that run as a pipeline destination. Timers and
    counters live in Redis (shared, survive restarts) or in memory for a single instance.
  </description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-commerce-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-event-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
