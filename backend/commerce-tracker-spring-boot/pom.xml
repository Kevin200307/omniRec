<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>commerce-tracker-spring-boot</artifactId>
  <packaging>jar</packaging>
  <description>
    The Spring Boot SDK a merchant embeds in their own application to report authoritative
    business events: purchases, refunds, cancellations, accepted reviews, registrations, and
    derived cart abandonment. Auto-configured; holds no provider credentials.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-commerce-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
