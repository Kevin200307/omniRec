<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-commerce-core</artifactId>
  <packaging>jar</packaging>
  <description>
    The canonical CommerceEvent model, the event taxonomy, validation, identity linking,
    deduplication, and the EventDestination interface. No Spring, no provider SDK, no queue -
    that absence is the point: every other module depends on this one, and it depends on nothing
    that would leak a vendor concept into the canonical shape.
  </description>

