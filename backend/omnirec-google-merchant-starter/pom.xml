<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-google-merchant-starter</artifactId>
  <packaging>jar</packaging>
  <description>
    Google Merchant Center catalog distribution, both modes behind one config switch:
    push (per-item Content API calls, implements CatalogProvider) and scheduled-fetch
    (a hosted feed file Google polls, implements FeedFileProvider). Shares
    GoogleMerchantItemMapper for CatalogItem to Merchant field mapping/validation —
    see that class for why "missing GTIN" and similar are caught before any API/file
    call is made, in either mode.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-content</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
    </dependency>
  </dependencies>
</project>
