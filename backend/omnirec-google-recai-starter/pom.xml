<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>2.0.0</version>
  </parent>

  <artifactId>omnirec-google-recai-starter</artifactId>
  <packaging>jar</packaging>
  <description>Google Cloud Retail (Recommendations AI) RecommendationProvider. Same shape as omnirec-personalize-starter - the second provider proves the abstraction, per the implementation plan's Phase 2 exit criteria.</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-retail</artifactId>
    </dependency>
  </dependencies>
</project>
