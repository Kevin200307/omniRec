<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-core</artifactId>
  <packaging>jar</packaging>
  <description>Canonical event model, provider interfaces (RecommendationProvider/SearchProvider/CacheProvider), the PersonalizationService facade, and in-memory fakes. No provider SDK dependencies — that's the point.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <!-- Used programmatically (RetryTemplate) by CatalogSyncServiceImpl, not via @Retryable/@EnableRetry -->
      <!-- see the class javadoc for why: AOP self-invocation pitfalls and Spring-context-free unit testing. -->
      <groupId>org.springframework.retry</groupId>
      <artifactId>spring-retry</artifactId>
    </dependency>
    <dependency>
      <!-- @PostConstruct/@PreDestroy on ScheduledFeedPublisher, which Spring's container invokes on any bean regardless of framework annotations elsewhere. -->
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
  </dependencies>
</project>
