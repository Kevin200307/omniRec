<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-openai-feed-starter</artifactId>
  <packaging>jar</packaging>
  <description>
    OpenAI Product Feed distribution — implements FeedFileProvider only, since this
    channel is explicitly a merchant-pushed structured file, not itemized API calls.
    No official Java SDK exists for this (a merchant-specific endpoint issued after
    OpenAI's own approval process), so this uses the JDK's built-in java.net.http.HttpClient
    rather than adding a dependency for a single POST call.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
