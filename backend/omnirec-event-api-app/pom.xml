<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.omnirec</groupId>
    <artifactId>omnirec-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>omnirec-event-api-app</artifactId>
  <packaging>jar</packaging>
  <description>
    The standalone, runnable Event API service: gateway + queue + every destination starter.
    Boots with no credentials on the in-memory stores, and swaps in real providers through
    configuration alone.
  </description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-event-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-event-processing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-amazon-personalize-destination</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-google-retail-destination</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-recently-viewed-destination</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-redis-state</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Optional historical storage. Inert unless omnirec.storage.enabled=true. -->
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>omnirec-event-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The backend SDK, to test its real HTTP path into this API end to end. -->
    <dependency>
      <groupId>io.omnirec</groupId>
      <artifactId>commerce-tracker-spring-boot</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Real RabbitMQ and Redis for the broker-level tests. Skipped automatically when
         no Docker daemon is available, so a laptop without Docker still builds. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
