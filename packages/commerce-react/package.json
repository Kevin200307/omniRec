{
  "name": "@omnirec/commerce-react",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin200307/omniRec.git",
    "directory": "packages/commerce-react"
  },
  "description": "React bindings for @omnirec/commerce-web - CommerceProvider and useCommerce().",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "dev": "tsup src/index.tsx --format esm,cjs --dts --watch --external react",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@omnirec/commerce-web": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
