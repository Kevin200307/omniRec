{
  "name": "@omnirec/commerce-web",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin200307/omniRec.git",
    "directory": "packages/commerce-web"
  },
  "description": "Provider-independent commerce event tracking for the browser. Vanilla JS, React, and Next.js - no provider SDK, no provider credentials.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./impressions": {
      "types": "./dist/impressions.d.ts",
      "import": "./dist/impressions.js",
      "require": "./dist/impressions.cjs"
    },
    "./autocapture": {
      "types": "./dist/autocapture.d.ts",
      "import": "./dist/autocapture.js",
      "require": "./dist/autocapture.cjs"
    },
    "./consent": {
      "types": "./dist/consent.d.ts",
      "import": "./dist/consent.js",
      "require": "./dist/consent.cjs"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js",
      "require": "./dist/debug.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
