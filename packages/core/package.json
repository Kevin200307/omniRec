{
  "name": "@omnirec/core",
  "version": "0.1.0",
  "description": "Omnirec tracker core — identity, event queue, transport, and plugin system for capturing e-commerce customer signals.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
