{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omnirec.dev/schema/v2/commerce-event.schema.json",
  "title": "CommerceEvent",
  "description": "The canonical OmniRec event, envelope version 2. Generated by `omnirec generate` from catalog/envelope/v2.schema.json and the catalog blocks. Event names are open: standard names come from the catalog and custom names from a tracking plan, so `event` is checked by pattern here and by the event registry at runtime. Per-event required fields are enforced by the validator, not by this schema. Version 1 is frozen at schema/v1/commerce-event.schema.json.",
  "type": "object",
  "required": [
    "eventId",
    "event",
    "schemaVersion",
    "timestamp",
    "identity"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Unique per event. The deduplication key — a repeated eventId is delivered once."
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "description": "Event name. Standard names are listed in x-omnirec-standard-events; aliases of older names are accepted and rewritten.",
      "x-omnirec-standard-events": [
        "home_page_viewed",
        "page_viewed",
        "return_visit",
        "scroll_depth_reached",
        "session_ended",
        "session_started",
        "ad_clicked",
        "ad_impression",
        "ad_video_completed",
        "ad_video_progress",
        "ad_video_started",
        "ad_viewable_impression",
        "affiliate_link_clicked",
        "influencer_content_viewed",
        "message_bounced",
        "message_clicked",
        "message_converted",
        "message_delivered",
        "message_opened",
        "message_sent",
        "qr_code_scanned",
        "referral_link_clicked",
        "social_post_viewed",
        "brand_followed",
        "brand_module_clicked",
        "brand_page_viewed",
        "brand_unfollowed",
        "category_viewed",
        "frequently_bought_together_clicked",
        "product_clicked",
        "product_list_viewed",
        "recommendation_added_to_cart",
        "recommendation_clicked",
        "recommendation_impression",
        "recommendation_purchased",
        "saved_for_later_viewed",
        "search_filter_applied",
        "search_filter_removed",
        "search_page_changed",
        "search_performed",
        "search_result_clicked",
        "search_results_viewed",
        "search_sort_changed",
        "search_started",
        "search_suggestion_selected",
        "similar_product_clicked",
        "wishlist_viewed",
        "back_in_stock_requested",
        "coupon_clipped",
        "deal_claimed",
        "delivery_info_viewed",
        "other_sellers_viewed",
        "price_comparison_viewed",
        "product_added_to_list",
        "product_compared",
        "product_content_clicked",
        "product_content_viewed",
        "product_image_zoomed",
        "product_media_viewed",
        "product_page_exited",
        "product_review_viewed",
        "product_saved_for_later",
        "product_shared",
        "product_video_completed",
        "product_video_started",
        "product_viewed",
        "product_wishlisted",
        "promotion_clicked",
        "quantity_changed",
        "question_viewed",
        "review_filtered",
        "review_media_viewed",
        "review_sorted",
        "review_voted",
        "stock_status_viewed",
        "subscription_option_selected",
        "variant_selected",
        "add_to_cart_failed",
        "buy_now_clicked",
        "cart_abandoned",
        "cart_item_moved_to_wishlist",
        "cart_item_saved_for_later",
        "cart_quantity_updated",
        "cart_viewed",
        "checkout_abandoned",
        "checkout_completed",
        "checkout_failed",
        "checkout_started",
        "checkout_step_viewed",
        "coupon_applied",
        "coupon_rejected",
        "delivery_option_selected",
        "gift_option_selected",
        "order_reviewed",
        "payment_information_added",
        "payment_information_changed",
        "product_added_to_cart",
        "product_removed_from_cart",
        "promotion_applied",
        "promotion_rejected",
        "shipping_information_added",
        "shipping_information_changed",
        "new_customer_purchase",
        "order_cancelled",
        "order_cancelled_by_seller",
        "order_confirmed",
        "order_fraud_reviewed",
        "order_placed",
        "order_refunded",
        "payment_authorized",
        "payment_captured",
        "payment_failed",
        "purchase_completed",
        "purchase_failed",
        "repeat_purchase",
        "replacement_order_created",
        "subscription_cancelled",
        "subscription_renewed",
        "subscription_started",
        "delivery_attempted",
        "delivery_completed",
        "delivery_estimate_changed",
        "delivery_failed",
        "delivery_feedback_submitted",
        "delivery_issue_reported",
        "fulfilment_started",
        "gift_delivery_confirmed",
        "reorder_reminder_viewed",
        "shipment_delayed",
        "shipment_out_for_delivery",
        "shipment_shipped",
        "shipment_tracking_viewed",
        "call_abandoned",
        "call_answered",
        "call_escalated",
        "call_started",
        "chatbot_answer_viewed",
        "chatbot_fallback_triggered",
        "chatbot_intent_detected",
        "chatbot_session_started",
        "complaint_resolved",
        "complaint_submitted",
        "faq_opened",
        "help_center_viewed",
        "live_chat_requested",
        "live_chat_resolved",
        "live_chat_started",
        "live_chat_transferred",
        "seller_message_received",
        "seller_message_replied",
        "support_ticket_created",
        "support_ticket_reopened",
        "support_ticket_resolved",
        "support_ticket_updated",
        "survey_completed",
        "survey_requested",
        "chargeback_opened",
        "chargeback_resolved",
        "exchange_completed",
        "exchange_requested",
        "recovery_offer_redeemed",
        "recovery_offer_sent",
        "refund_approved",
        "refund_issued",
        "refund_requested",
        "replacement_requested",
        "replacement_shipped",
        "return_approved",
        "return_initiated",
        "return_inspected",
        "return_label_generated",
        "return_received",
        "return_rejected",
        "return_shipped",
        "negative_feedback_received",
        "negative_feedback_response_sent",
        "product_review_submitted",
        "question_answered",
        "question_asked",
        "referral_converted",
        "referral_shared",
        "review_helpful_vote_received",
        "review_media_uploaded",
        "review_replied",
        "review_request_viewed",
        "review_requested",
        "seller_feedback_submitted",
        "ugc_created",
        "ugc_shared",
        "channel_subscribed",
        "channel_unsubscribed",
        "churn_risk_detected",
        "consent_granted",
        "consent_revoked",
        "cross_sell_offer_clicked",
        "cross_sell_offer_viewed",
        "customer_reactivated",
        "loyalty_reward_redeemed",
        "loyalty_status_changed",
        "preference_center_viewed",
        "user_logged_in",
        "user_logged_out",
        "user_profile_updated",
        "user_registered",
        "identify"
      ]
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Version of this event's definition in the catalog or plan."
    },
    "kind": {
      "enum": [
        "standard",
        "custom"
      ],
      "description": "Set server-side from the registry. A client-supplied value is ignored."
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^2.[0-9]+$",
      "default": "2.0",
      "description": "Envelope version. Bumped only on a breaking change."
    },
    "source": {
      "enum": [
        "browser",
        "server",
        "webhook",
        "derived",
        "import"
      ],
      "description": "Which kind of producer sent the event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Client capture time. Clamped server-side if implausibly skewed; see receivedAt for the authoritative server time."
    },
    "tenantId": {
      "type": "string",
      "description": "Set server-side from the authenticated API key. A value supplied by the client is ignored."
    },
    "identity": {
      "type": "object",
      "description": "Never merged in place. An event captured anonymously keeps its null userId forever; the anonymousId -> userId association lives separately as an identity link.",
      "required": [
        "anonymousId",
        "sessionId"
      ],
      "additionalProperties": false,
      "properties": {
        "anonymousId": {
          "type": "string",
          "description": "First-party device identity. Never an IP address and never a fingerprint."
        },
        "userId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Merchant's own customer id. Supplied via identify(); the SDK never invents one."
        },
        "sessionId": {
          "type": "string",
          "description": "Current browsing session. New session after the configured inactivity timeout (default 30 minutes) or on logout."
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Where the event happened. ip and country are server-derived and overwrite whatever the client sent.",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "referrer": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android",
            "server",
            "unknown"
          ]
        },
        "device": {
          "type": "string",
          "enum": [
            "desktop",
            "mobile",
            "tablet",
            "unknown"
          ]
        },
        "userAgent": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "screenWidth": {
          "type": "integer"
        },
        "screenHeight": {
          "type": "integer"
        },
        "ip": {
          "type": [
            "string",
            "null"
          ],
          "description": "Server-derived only. Dropped unless retain-ip-address is enabled."
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "description": "Server-derived only."
        },
        "campaign": {
          "type": "object",
          "additionalProperties": false,
          "description": "Marketing attribution parsed from the landing URL. Persisted for the session.",
          "properties": {
            "source": {
              "type": "string"
            },
            "medium": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "term": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "clickId": {
              "type": "string",
              "description": "gclid, fbclid, msclkid or ttclid value."
            },
            "clickIdType": {
              "enum": [
                "gclid",
                "fbclid",
                "msclkid",
                "ttclid"
              ]
            }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "Page kind declared by the storefront, for example home, product, category, cart."
            },
            "title": {
              "type": "string"
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "description": "The event's payload, grouped into blocks from the catalog. Inline fields declared by a tracking plan sit beside the blocks.",
      "properties": {
        "ad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Ad or creative identifier."
            },
            "campaignId": {
              "type": "string"
            },
            "adGroupId": {
              "type": "string"
            },
            "network": {
              "type": "string",
              "description": "Ad network, for example google_ads, meta, amazon_ads."
            },
            "format": {
              "enum": [
                "search",
                "display",
                "video",
                "shopping",
                "sponsored_product",
                "sponsored_brand",
                "sponsored_display",
                "social",
                "retargeting",
                "native",
                "other"
              ]
            },
            "placement": {
              "type": "string"
            },
            "keyword": {
              "type": "string"
            },
            "targetingType": {
              "type": "string"
            },
            "position": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "An ad the shopper saw or clicked."
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "description": "A brand or brand store."
        },
        "cart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Merchant cart identifier."
            },
            "total": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0,
              "description": "Cart value in currency."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "price": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "categoryId": {
                    "type": "string"
                  }
                },
                "required": [
                  "productId"
                ]
              },
              "description": "Cart lines."
            }
          },
          "description": "The shopping cart."
        },
        "category": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Merchant category identifier."
            },
            "name": {
              "type": "string",
              "description": "Human-readable category name."
            }
          },
          "description": "A product category."
        },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Identifier of the list or placement."
            },
            "name": {
              "type": "string"
            },
            "position": {
              "type": "integer",
              "minimum": 1,
              "description": "1-based position of the product the event is about, within the list."
            },
            "productIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Products shown, in display order."
            },
            "type": {
              "type": "string",
              "description": "For example search, category, best_sellers, deals, coupons, carousel."
            }
          },
          "description": "A list or placement of several products, such as a grid, carousel or promotion row."
        },
        "loyalty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tier": {
              "type": "string"
            },
            "previousTier": {
              "type": "string"
            },
            "points": {
              "type": "integer"
            },
            "rewardId": {
              "type": "string"
            }
          },
          "description": "Loyalty programme status."
        },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Message or send identifier from the messaging tool."
            },
            "channel": {
              "enum": [
                "email",
                "sms",
                "push",
                "in_app",
                "whatsapp"
              ]
            },
            "campaignId": {
              "type": "string"
            },
            "templateId": {
              "type": "string"
            },
            "category": {
              "type": "string",
              "description": "For example newsletter, price_drop_alert, back_in_stock_alert, win_back, replenishment."
            }
          },
          "description": "An email, SMS, push or in-app message."
        },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Merchant order identifier, or a hashed reference."
            },
            "total": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0,
              "description": "Order total in currency."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "price": {
                    "type": [
                      "number",
                      "string"
                    ],
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "categoryId": {
                    "type": "string"
                  }
                },
                "required": [
                  "productId"
                ]
              },
              "description": "Order lines."
            },
            "tax": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "shipping": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "discount": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "coupon": {
              "type": "string",
              "maxLength": 64
            },
            "fulfilmentMethod": {
              "enum": [
                "merchant",
                "marketplace",
                "third_party_logistics",
                "store_pickup",
                "dropship"
              ]
            },
            "marketplace": {
              "type": "string",
              "description": "Marketplace or storefront, for example amazon_us or web."
            }
          },
          "description": "An order. Report authoritative order facts from the server."
        },
        "payment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "method": {
              "enum": [
                "card",
                "wallet",
                "bank_transfer",
                "buy_now_pay_later",
                "cash_on_delivery",
                "gift_card",
                "store_credit",
                "other"
              ]
            },
            "provider": {
              "type": "string"
            },
            "amount": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "failureReason": {
              "type": "string"
            }
          },
          "description": "A payment, refund or chargeback amount."
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 256,
              "description": "Merchant product identifier."
            },
            "variantId": {
              "type": "string",
              "description": "Selected variant (size, colour) when it differs from the product id."
            },
            "name": {
              "type": "string",
              "description": "Product name as shown to the shopper."
            },
            "brand": {
              "type": "string"
            },
            "price": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0,
              "description": "Unit price in currency."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 code of price."
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "description": "Units involved in this event."
            },
            "sku": {
              "type": "string",
              "description": "Merchant SKU."
            },
            "parentId": {
              "type": "string",
              "description": "Parent product, for example a parent ASIN or a product group."
            }
          },
          "description": "The single product an event is about."
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "couponCode": {
              "type": "string",
              "maxLength": 64
            },
            "discount": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "type": {
              "type": "string",
              "description": "For example percent_off, amount_off, free_shipping, bundle."
            }
          },
          "description": "A promotion, coupon or deal."
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Recommendation id issued by the provider."
            },
            "provider": {
              "type": "string",
              "description": "Who served the list, for example amazon-personalize. Attribution goes only to this provider."
            }
          },
          "description": "The recommendation list an interaction came from, for attribution back to the provider that served it."
        },
        "referral": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 64
            },
            "channel": {
              "type": "string"
            }
          },
          "description": "A referral."
        },
        "return": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "orderId": {
              "type": "string"
            },
            "reason": {
              "enum": [
                "damaged_or_defective",
                "wrong_item",
                "not_as_described",
                "poor_quality",
                "size_or_fit_issue",
                "late_delivery",
                "changed_mind",
                "duplicate_order",
                "missing_parts",
                "compatibility_issue",
                "price_issue",
                "other"
              ]
            },
            "method": {
              "type": "string"
            },
            "refundAmount": {
              "type": [
                "number",
                "string"
              ],
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "productId": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
